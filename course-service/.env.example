APP__TITLE="Course Service"
APP__VERSION="1.0.0"
DATABASE__DSN=postgresql://postgres:postgres@127.0.0.1:5432/courses
DATABASE__MIN_POOL_SIZE=1
DATABASE__MAX_POOL_SIZE=10
DATABASE__COMMAND_TIMEOUT=10
AUTH__SECRET=replace-with-a-random-secret-at-least-32-characters
CHECKER__TIMEOUT=5
CHECKER__CONCURRENCY=5
MAX_UPLOAD_BYTES=10485760
CORS_ORIGINS=[]
LOG_LEVEL=INFO
